{
  "name": "@ozzylabs/feedradar",
  "version": "0.2.3",
  "description": "Multi-agent CLI that watches blogs and release feeds, then turns keyword hits into Markdown research reports",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "radar": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && pnpm run build:skills",
    "build:skills": "node scripts/copy-skills.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "radar": "node dist/index.js",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.3",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^7.1.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": "^1.60.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.6",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozzy-labs/feedradar.git"
  },
  "homepage": "https://github.com/ozzy-labs/feedradar#readme",
  "bugs": {
    "url": "https://github.com/ozzy-labs/feedradar/issues"
  },
  "keywords": [
    "feedradar",
    "radar",
    "feed",
    "rss",
    "release-notes",
    "ai",
    "ai-agents",
    "agentic",
    "claude-code",
    "codex",
    "gemini",
    "copilot",
    "cli",
    "multi-agent",
    "research",
    "markdown"
  ],
  "author": "ozzy-labs",
  "engines": {
    "node": ">=22.21.0 || >=24.5.0"
  }
}
